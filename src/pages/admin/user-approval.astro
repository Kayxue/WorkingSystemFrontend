---
import Layout from '../../layouts/AdminLayout.astro';
import UserApprovalList from '../../components/admin/UserApprovalList.solid.tsx';
import { BACKEND_BASE_URL } from '../../Constant';

const response = await fetch(`${BACKEND_BASE_URL}/admin/pendingEmployer`, {
    method: 'GET',
    headers: {
        'Content-Type': 'application/json',
        'platform': "web-admin",
        'Cookie': Astro.request.headers.get('cookie') || ''
    },
    credentials: 'include'
});

const pendingUsers = await response.json();
---

<Layout title="User Approval" currentPath="/user-approval">
  <div class="space-y-6">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">User Approval</h1>
        <p class="text-sm text-gray-600 mt-1">Review and approve new user registrations</p>
      </div>
    </div>
    <div>
    <!-- User Approval List -->
    <UserApprovalList client:load initialData={pendingUsers} />
  </div>
</Layout>